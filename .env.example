# Copy to .env and fill in. Run `node scripts/gen-keys.mjs` to generate the secrets.
# Quote values that contain spaces: the scripts source this file in bash.

# Root domain. The API is served at api.$DOMAIN and each app at <app>.$DOMAIN (or its own domain).
DOMAIN=example.com
# Email Caddy uses for Let's Encrypt certificates.
ACME_EMAIL=you@example.com

############ Secrets (generate with scripts/gen-keys.mjs) ############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

############ Database ############
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_EXPIRY=3600

############ Auth (GoTrue) ############
# Fallback redirect after email confirmation when an app doesn't pass its own.
SITE_URL=https://example.com
# Redirect URLs apps may send users back to after login. Covers every subdomain.
ADDITIONAL_REDIRECT_URLS=https://*.example.com/**,http://localhost:5173/**
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# true = no email confirmation step. Keep false in production once SMTP works.
ENABLE_EMAIL_AUTOCONFIRM=false

# SMTP for magic links / confirmations (Resend, Postmark, SES, Mailgun...).
SMTP_ADMIN_EMAIL=you@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME="My Apps"

# Optional Google login (Base44 apps usually use "Sign in with Google").
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
